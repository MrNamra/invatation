# Supabase Configuration
# Leave blank to run in zero-config local file mode (.data/store.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL used for generating WhatsApp invitation links (optional; defaults to browser origin)
NEXT_PUBLIC_APP_URL=

# Single-User Host Login Configuration
# Registration is disabled by default; only this single host account can log in
HOST_ADMIN_EMAIL=admin@patrika.local
HOST_ADMIN_PASSWORD=replace-with-strong-password
ALLOW_REGISTRATION=false
AUTH_SESSION_SECRET=
